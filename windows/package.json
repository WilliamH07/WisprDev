{
  "name": "wisper-windows",
  "version": "0.1.0",
  "description": "Wisper for Windows: hold-to-talk dictation with fast AI cleanup and selected-text rewrite.",
  "main": "src/main/main.js",
  "author": "William HANCZYK",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --win dir --x64 --publish never"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.williamh07.wisper.windows",
    "productName": "Wisper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Wisper-Setup-${version}.${ext}",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false
  }
}
